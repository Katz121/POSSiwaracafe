// =============================================================================
// Siwara POS — Firestore Security Rules
// =============================================================================
//
// SECURITY MODEL (read this before editing):
//
//   Both staff (POS/admin UI) and customers (self-ordering at /order) sign in
//   with Firebase Anonymous Auth. This means every browser tab that loads
//   either app automatically gets a valid, anonymous Firebase token.
//
//   CONSEQUENCE: at the Firestore rules layer, staff and customers are
//   INDISTINGUISHABLE — both are `request.auth != null` with
//   `request.auth.token.firebase.sign_in_provider == 'anonymous'`.
//
//   These rules therefore provide:
//     ✓ Block unauthenticated / raw-HTTP access entirely (requires a token).
//     ✓ Light validation on order creation (status, total, items fields).
//     ✗ They do NOT cryptographically prevent a determined customer from
//       writing to staff-only collections, because the anonymous token is
//       issued to anyone who loads the page.
//
//   TO UPGRADE to true staff/customer separation later:
//     1. Migrate staff login to Firebase Email/Password auth.
//     2. Uncomment the STAFF-ONLY example rules below.
//     3. Remove the blanket `request.auth != null` write grants from
//        staff-only collections (stock, expenses, members, etc.).
//
// =============================================================================
//
// STAFF-ONLY write example (uncomment after migrating staff to email/password):
//
//   function isStaff() {
//     return request.auth != null &&
//            request.auth.token.firebase.sign_in_provider == 'password';
//   }
//
//   // Then replace `request.auth != null` with `isStaff()` for any rule
//   // that should be restricted to authenticated staff only.  Example:
//   //
//   //   match /expenses/{id} {
//   //     allow read, write: if isStaff();
//   //   }
//
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deny everything by default ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── App data namespace ───────────────────────────────────────────────────
    match /artifacts/{appId}/public/data {

      // ── Menu & catalogue (customers + staff need to read) ────────────────
      match /menu/{id} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /categories/{id} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /beanModifiers/{id} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // ── Config docs ──────────────────────────────────────────────────────
      // config/settings — staff read+write; customers read (for display config)
      match /config/settings {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // config/publicMenu — staff (POS) publishes a single bundled snapshot of
      // menu+categories+beanModifiers+settings; customers read this ONE doc
      // instead of subscribing to the four source collections (cuts reads).
      match /config/publicMenu {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // config/queue — both staff and customers read+write
      // (customer self-order increments the queue counter in a transaction)
      match /config/queue {
        allow read, write: if request.auth != null;
      }

      // ── Orders ────────────────────────────────────────────────────────────
      // Any authenticated user (staff or customer) may CREATE an order,
      // subject to light validation:
      //   • status must be 'pending'  (not 'done' / 'cancelled' at creation)
      //   • total must be a number ≥ 0
      //   • items must be a list
      match /orders/{id} {
        allow create: if request.auth != null
                      && request.resource.data.status == 'pending'
                      && request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.items is list;

        // Staff read, update (status changes), delete (cancel/void)
        allow read, update, delete: if request.auth != null;
      }

      // ── Staff-managed collections ─────────────────────────────────────────
      // Note: guarded only by token presence today.
      // Replace `request.auth != null` with `isStaff()` after email/password migration.

      match /stock/{id} {
        allow read, write: if request.auth != null;
      }

      match /expenses/{id} {
        allow read, write: if request.auth != null;
      }

      match /members/{id} {
        allow read, write: if request.auth != null;
      }

      match /quickExpenses/{id} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
