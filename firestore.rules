// =============================================================================
// Siwara POS — Firestore Security Rules
// =============================================================================
//
// โมเดลความปลอดภัย (อ่านก่อนแก้)
//
//   พนักงานล็อกอินด้วย Email/Password (ดู `src/hooks/useStaffAuth.js`)
//   ลูกค้าที่สแกน QR ล็อกอินแบบ Anonymous อัตโนมัติ
//   สอง provider นี้แยกกันได้ที่ชั้น rules จึงใช้ `isStaff()` คุมสิทธิ์ได้จริง
//
//   ก่อนหน้านี้ rules ใช้ `request.auth != null` ทุกที่ ซึ่งแปลว่า **ลูกค้าที่
//   สแกน QR มีสิทธิ์เท่าพนักงานทุกอย่าง** ตรวจแล้วพบว่าอ่าน `config/settings`
//   ได้จริงและเห็นทั้ง `adminPin` กับ `geminiApiKey` รวมถึงลบเมนูทั้งร้าน
//   แก้บิลคนอื่น และแก้แต้มสมาชิกได้
//
// หลักที่ใช้
//   • ลูกค้าอ่านได้เฉพาะสิ่งที่ต้องใช้สั่งของ และเขียนได้เฉพาะทางที่จำเป็น
//   • ข้อมูลภายในร้าน (สต็อก รายจ่าย สมาชิก การตั้งค่า บิลเก่า) พนักงานเท่านั้น
//   • เส้นทางสำรองตอน Cloud Function ล่ม (ดู `src/services/checkoutFallback.js`)
//     ต้องยังทำงานได้ ไม่งั้นปิดช่องโหว่แล้วลูกค้าสั่งของไม่ได้
//
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // พนักงาน = ล็อกอินด้วยรหัสผ่าน · ลูกค้า QR = anonymous จึงไม่เข้าเงื่อนไขนี้
    function isStaff() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function signedIn() {
      return request.auth != null;
    }

    // ── ปิดทุกอย่างเป็นค่าเริ่มต้น ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/public/data {

      // ── เมนูและแคตตาล็อก ────────────────────────────────────────────────
      // ลูกค้าต้องอ่านได้เพื่อสั่งของ (และเป็นทางสำรองเมื่อ publicMenu หาย)
      // แต่แก้ไขได้เฉพาะพนักงาน · ยกเว้น soldCount ที่หน้าลูกค้าบวกเองหลังสั่ง
      // สำเร็จ (ดู `src/utils/menuSales.js`) จึงอนุญาตเฉพาะฟิลด์นั้นฟิลด์เดียว
      match /menu/{id} {
        allow read: if signedIn();
        allow write: if isStaff();
        allow update: if signedIn()
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['soldCount']);
      }

      match /categories/{id} {
        allow read: if signedIn();
        allow write: if isStaff();
      }

      // ── ตัวนับ funnel หน้า QR (ดู `src/utils/qrFunnel.js`) ──────────────────
      // ตัวเลขรวมรายวันเท่านั้น ไม่มีชื่อ/เบอร์/รายการสั่ง · ลูกค้าบวกได้ครั้งละ +1
      // ที่ขั้นเดียวจากรายชื่อที่กำหนด · อ่านได้เฉพาะพนักงาน
      function funnelSteps() {
        return ['view', 'add', 'cart', 'checkout', 'order'];
      }
      // affectedKeys() เป็น Set (ไม่มี toList/index) จึงตรวจทีละขั้นว่า "ถ้าขั้นนี้
      // เปลี่ยน ต้องเพิ่มขึ้น 1 พอดี" · รวมกับ size() == 1 = บวกได้ขั้นเดียวครั้งละ +1
      function funnelStepOk(changed, before, k) {
        return !(k in changed) || request.resource.data[k] == before.get(k, 0) + 1;
      }
      function funnelPlusOne(before) {
        let changed = request.resource.data.diff(before).affectedKeys();
        return changed.size() == 1
               && changed.hasOnly(funnelSteps())
               && request.resource.data.keys().hasOnly(funnelSteps())
               && funnelStepOk(changed, before, 'view')
               && funnelStepOk(changed, before, 'add')
               && funnelStepOk(changed, before, 'cart')
               && funnelStepOk(changed, before, 'checkout')
               && funnelStepOk(changed, before, 'order');
      }
      match /qrFunnel/{day} {
        allow read, delete: if isStaff();
        allow create: if signedIn()
                      && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                      && funnelPlusOne({});
        allow update: if signedIn() && funnelPlusOne(resource.data);
      }

      match /beanModifiers/{id} {
        allow read: if signedIn();
        allow write: if isStaff();
      }

      // ── เอกสารตั้งค่า ────────────────────────────────────────────────────
      // config/settings เก็บ adminPin กับ geminiApiKey จึงเป็นของพนักงานล้วน
      // ลูกค้าใช้ config/publicMenu ที่มี settings ชุดปลอดภัยฝังมาให้แล้ว
      // (ดู SENSITIVE_SETTINGS_KEYS ใน `src/utils/publicMenu.js`)
      match /config/settings {
        allow read, write: if isStaff();
      }

      // publicMenu = สแนปช็อตรวม menu + categories + beanModifiers + settings
      // ที่ตัดฟิลด์อ่อนไหวออกแล้ว · ลูกค้าอ่านได้ พนักงานเป็นคนเผยแพร่
      match /config/publicMenu {
        allow read: if signedIn();
        allow write: if isStaff();
      }

      // config/queue — ลูกค้าต้องกดคิวเองได้ในเส้นทางสำรองตอน Cloud Function ล่ม
      // เสี่ยงแค่เลขคิวเพี้ยน ซึ่งแก้ตามหลังได้ ต่างจากการปล่อยให้แก้เมนูหรือบิล
      match /config/queue {
        allow read, write: if signedIn();
      }

      // ── บิล ──────────────────────────────────────────────────────────────
      // ลูกค้าสร้างบิลของตัวเองได้ (เส้นทางสำรอง) โดยต้องผ่านการตรวจเบื้องต้น
      // แต่ **อ่านบิลคนอื่นไม่ได้** เพราะบิลมีชื่อและเบอร์โทรลูกค้าอยู่
      // และแก้หรือลบบิลไม่ได้เลย ไม่งั้นตรวจตอนสร้างไปก็ไร้ความหมาย
      match /orders/{id} {
        allow create: if signedIn()
                      && request.resource.data.status == 'pending'
                      && request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.items is list;

        allow read, update, delete: if isStaff();
      }

      // ── ข้อมูลภายในร้าน · พนักงานเท่านั้น ────────────────────────────────
      match /stock/{id} {
        allow read, write: if isStaff();
      }

      match /expenses/{id} {
        allow read, write: if isStaff();
      }

      // สมาชิกมีเบอร์โทรและประวัติการซื้อ · ลูกค้าเปิดดูบัตรของตัวเองได้ด้วย
      // การรู้เบอร์ตัวเอง (get) แต่ห้ามไล่อ่านทั้งตาราง (list) และห้ามแก้แต้ม
      match /members/{id} {
        allow get: if signedIn();
        allow list, write: if isStaff();
      }

      match /quickExpenses/{id} {
        allow read, write: if isStaff();
      }

      // เอกสารกันส่งซ้ำของ Cloud Function · ตัว function ใช้ Admin SDK จึงข้าม
      // rules อยู่แล้ว · เปิดให้พนักงานอ่าน/ลบไว้เผื่อต้องตามเก็บกวาด
      // ลูกค้าไม่ควรเห็น เพราะ id มี uid ของลูกค้าคนอื่นอยู่
      match /checkoutRequests/{id} {
        allow read, write: if isStaff();
      }

      match /financial_plans/{id} {
        allow read, write: if isStaff();
      }
    }
  }
}
