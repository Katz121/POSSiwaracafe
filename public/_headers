# Cloudflare Pages response headers.
# Goal: the browser must ALWAYS revalidate index.html so a new deploy shows up
# immediately, while hash-named build assets can be cached forever safely.

# Default for everything (incl. HTML / SPA routes): never trust a cached copy
# without checking the server first.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Vite build output is content-hashed (e.g. index-CJG9bo8K.js) — a new build
# means a new filename, so these are immutable and can be cached long-term.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service-worker tombstone must propagate fast — never let it be cached.
/sw.js
  Cache-Control: no-cache
